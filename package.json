{
  "name": "map-of-middle-earth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cinematic miniature 3D diorama of Middle-earth (Three.js WebGPU) and the 'Journey Through Middle-Earth' virtual-tour film.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "node --import tsx tools/heavy.ts build -- vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "data:fetch": "node tools/refs/fetch-data.mjs",
    "refs:fetch": "node tools/refs/fetch.mjs",
    "bake": "node --import tsx tools/heavy.ts bake --min-free-mb 2500 -- uv run --project tools/bake python tools/bake/run.py",
    "shots": "node --import tsx tools/capture/shots.ts",
    "qa": "node --import tsx tools/capture/qa.ts",
    "check": "node --import tsx tools/check/run.ts",
    "perf": "node --import tsx tools/capture/perf.ts",
    "host": "node --import tsx tools/host.ts"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  }
}
