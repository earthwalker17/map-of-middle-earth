{
  "version": 1,
  "status": "draft",
  "notes": "Journey Through Middle-Earth (S5 draft). One day on dayOfYear 78 (sunrise 6.09, sunset 17.91, key → moon at 18.32, full night 19.37; waxing moon ≈ 70 % lit, 57–62° up from 18:00). Beats alternate hold / move; durations are cumulative. Camera keys reference landmark bookmarks or QA shots (+ `set` overrides) and never edit them (five bookmarks are lock-v1 sentinels). Azimuths keep the camera mostly south of the route so the low sun side-lights the land (right in the morning, left in the afternoon); Minas Tirith is at blue hour (Mindolluin shades it all afternoon). Compiled by src/tour/compile.ts; checked by tools/check/film.ts (pnpm check).",
  "film": {
    "fps": 24,
    "shutter": 0.5,
    "dayOfYear": 78,
    "lengthS": [195, 240],
    "tFxScale": 0.6,
    "weather": { "cloudCoverage": 0.3, "wind": [0.6, 0.2] }
  },
