# dependencies / builds
node_modules/
dist/
.vite/
*.tsbuildinfo

# python
.venv/
__pycache__/
*.pyc

# third-party source data & derived bake outputs (never pushed — regenerate with `pnpm data:fetch` + `pnpm bake`)
# (data/source/ keeps only its README + manifest; git cannot re-include a file under an excluded dir,
#  so ignore the directory's *contents* instead of the directory itself)
data/source/*
!data/source/README.md
!data/source/manifest.json
data/baked/
data/baked-*/

# reference material is dev-only (binaries never pushed; README + manifest are committed)
reference/**
!reference/README.md
!reference/manifest.json
!reference/*/
reference/_fragments/

# third-party CC0 texture sources are fetched by script (manifest committed) and never shipped;
# the runtime terrain detail layers in public/textures/ are derived from them (tools/textures/prep.mjs)
data/textures-src/*
!data/textures-src/manifest.json
public/textures/**

# renders, captures, caches
renders/
.cache/
*.log

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# agent worktrees (Claude Code)
.claude/worktrees/
